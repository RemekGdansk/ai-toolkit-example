{
  "name": "@remekgdansk/ai-toolkit-example",
  "version": "0.2.0",
  "description": "Installs the author's AI-agent skills into a consumer repo as a Claude Code skills-directory plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RemekGdansk/ai-toolkit-example.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "bin": {
    "ai-toolkit-example": "dist/cli.js"
  },
  "files": [
    "dist/",
    "plugin/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && npm run typecheck:plugin && node --test 'test/**/*.test.ts'",
    "typecheck:plugin": "tsc -p tsconfig.plugin.json",
    "validate:plugin": "claude plugin validate plugin --strict"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
